# Public Firebase Web App configuration (Project settings > Your apps).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Server only: from the Firebase service-account JSON (client_email and private_key).
# Paste the full private_key in quotes, retaining its \n escapes.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server only: your ImgBB API v1 key and the primary Firebase Auth user's UID.
IMGBB_API_KEY=
ADMIN_UID=

# Optional analytics. These can be left blank / false.
FIREBASE_MEASUREMENT_ID=
FIREBASE_ANALYTICS_ENABLED=false
